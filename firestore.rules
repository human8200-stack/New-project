rules_version = '2';

// 가족(households) 문서 하나에 기록을 저장한다.
// members 배열에 있는 Google 계정(이메일 인증된 계정)만 읽고 쓸 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMember(data) {
      return signedIn() && request.auth.token.email in data.members;
    }

    match /households/{hid} {
      allow read: if isMember(resource.data);
      // 처음 로그인한 사람이 자기 uid로만 만들 수 있고, 처음 멤버는 자기 자신뿐
      allow create: if signedIn()
        && hid == request.auth.uid
        && request.resource.data.members == [request.auth.token.email]
        && request.resource.data.ownerEmail == request.auth.token.email;
      // 바꾼 뒤에도 내가 멤버여야 한다 (자기 자신을 빼서 잠그는 것 방지)
      // 처음 만든 계정(아이)은 뺄 수 없다
      allow update: if isMember(resource.data) && isMember(request.resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && resource.data.ownerEmail in request.resource.data.members;
      allow delete: if false;

      match /images/{imageId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/households/$(hid)).data);
      }
    }
  }
}
